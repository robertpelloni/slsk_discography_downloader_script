# Configuration
PORT=8000
DOWNLOAD_PATH=downloads

# Add your SLSK credentials here (in discography_webapp/.env) or configure them in the UI
SLSK_USER=placeholder
SLSK_PASS=placeholder

# Secondary account for Rust Search Boost (to avoid connection conflicts)
SLSK_BOOST_USER=
SLSK_BOOST_PASS=

# Optional Genius API key for fallback lyrics lookup
GENIUS_API_KEY=

# Enable or disable AcoustID/Neural Sentinel AI features
ENABLE_NEURAL_SENTINEL=true

# Agent Autonomous settings
AGENT_API_KEY=
AGENT_API_BASE=
